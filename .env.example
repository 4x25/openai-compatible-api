# ============================================================
# 环境变量示例（复制为 .env 使用；.env 已被 gitignore）
# ============================================================

# 可选：生产服务启动时的监听端口，默认 3000（Hostless 使用 8000）
# PORT=3000

# 可选：覆盖某供应商的默认上游 baseUrl
# 命名规则：${PROVIDER_ID 大写}_BASE_URL（id 中非字母数字字符转下划线）
# IFM_BASE_URL=https://api.ifm.ai/v1
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
# 调试透传供应商 _（/_/https://... 形式可绕过此变量）
# ⚠️ 透传供应商 _ 会把任意路径/方法/请求头发往任意上游，仅限本机或可信环境使用，勿在公网暴露
# __BASE_URL=https://api.openai.com/v1

# 可选：开发/联调阶段的兜底凭证
# 仅当使用方未传任何凭证时生效（客户端 Authorization > x-api-key > 本变量）
# ⚠️ 生产环境永远不要设置任何 *_API_KEY_FOR_DEV
# IFM_API_KEY_FOR_DEV=
# AGNES_API_KEY_FOR_DEV=
# INCEPTION_API_KEY_FOR_DEV=
# 设为 playground 可仅在本机调试官方 Playground（无需真实 Key）

# 可选：上游请求超时（毫秒），默认 300000
# UPSTREAM_TIMEOUT_MS=300000
