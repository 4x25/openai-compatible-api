# ============================================================
# 环境变量示例（复制为 .env 使用；.env 已被 gitignore）
# ============================================================

# 可选：覆盖某供应商的默认上游 baseUrl
# 命名规则：${PROVIDER_ID 大写}_BASE_URL（id 中非字母数字字符转下划线）
# SALTYFISH_BASE_URL=https://ai.saltyfish.live/v1
# IFM_BASE_URL=https://api.ifm.ai/v1

# 可选：开发/联调阶段的兜底凭证
# 仅当使用方未传任何凭证时生效（客户端 Authorization > x-api-key > 本变量）
# ⚠️ 生产环境永远不要设置任何 *_API_KEY_FOR_DEV
# SALTYFISH_API_KEY_FOR_DEV=
# IFM_API_KEY_FOR_DEV=

# 可选：上游请求超时（毫秒），默认 300000
# UPSTREAM_TIMEOUT_MS=300000
